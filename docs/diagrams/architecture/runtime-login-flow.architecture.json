  "cards": [
    {
      "dot": "cyan",
      "title": "Primary path: authorization-code login",
      "items": [
        "Browser hits /realms/{realm}/protocol/openid-connect/auth; AuthorizationEndpoint creates an auth session and starts the realm browser flow",
        "Login forms are rendered by FreeMarker themes and posted back to /login-actions/authenticate",
        "On success attachSession() creates the user session and the browser is redirected to the client with a code",
        "The client exchanges the code back-channel at /token; TokenManager builds and signs ID, access and refresh tokens"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "Browser and client apps are untrusted callers; confidential clients authenticate at /token",
        "LDAP and external IdPs are separately operated trust domains reached over the network",
        "The database and any remote Infinispan are operator-managed infrastructure"
      ]
    },
    {
      "dot": "emerald",
      "title": "Storage and clustering",
      "items": [
        "Realms, clients, users, credentials and events live in the relational DB via JPA",
        "Sessions are held in Infinispan caches; persistent sessions also write rows through the JPA persister",
        "Infinispan also carries realm/user caches and cluster invalidation"
      ]
    },
    {
      "dot": "violet",
      "title": "Also on the same server",
      "items": [
        "Admin REST (/admin) and admin console, authorized by bearer tokens via AdminRoot",
        "Account console, SAML, client registration, SCIM and authorization services",
        "EventBuilder fans out to event listeners and the JPA event store",
        "Extensible through SPIs: authenticators, user storage, protocol mappers, themes"
      ]
    }
  ]
