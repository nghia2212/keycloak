  "cards": [
    {
      "dot": "cyan",
      "title": "Reading the arrows",
      "items": [
        "Arrows are Maven dependencies (dependent → dependency), taken from each module's pom.xml",
        "The emphasised spine is the build chain from the distribution down to core/common",
        "quarkus/runtime depends on every implementation module; only its main edges are drawn"
      ]
    },
    {
      "dot": "violet",
      "title": "Layering facts",
      "items": [
        "server-spi is the public extension API; server-spi-private holds internal SPIs",
        "Storage implementations (model/jpa, model/infinispan, federation/ldap) depend on services, not only on the SPIs",
        "model/infinispan builds on model/jpa (persistent sessions use JPA)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Merged into nodes",
      "items": [
        "quarkus/dist: also quarkus/server and quarkus/deployment (build-time augmentation)",
        "model/storage*: storage, storage-private, storage-services (export/import)",
        "rest/*: admin-ui-ext, admin-v2; plus scim/*, ssf/*, authzen, authz/policy, saml-core"
      ]
    },
    {
      "dot": "amber",
      "title": "Not drawn",
      "items": [
        "crypto/* (default, elytron, fips1402) chosen via keycloak.crypto.artifactId",
        "Clients: integration/* (admin client, kcadm/kcreg CLI), adapters/*",
        "Test infrastructure: test-framework, tests, testsuite"
      ]
    }
  ]
