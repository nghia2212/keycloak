  "cards": [
    {
      "dot": "cyan",
      "title": "Scope",
      "items": [
        "Module common/ (keycloak-common), packages org.keycloak.common, .profile and .crypto",
        "Members are selected, not exhaustive; Profile.Feature has many more constants"
      ]
    },
    {
      "dot": "violet",
      "title": "Crypto SPI",
      "items": [
        "CryptoIntegration.init() loads CryptoProvider via ServiceLoader and keeps the highest-order one",
        "Implementations live in crypto/default, crypto/elytron and crypto/fips1402",
        "FipsMode names the provider class for each FIPS mode"
      ]
    },
    {
      "dot": "emerald",
      "title": "Not drawn",
      "items": [
        "util/ (~50 helpers: Base64, KeycloakUriBuilder, MultivaluedHashMap, Time, …)",
