  "cards": [
    {
      "dot": "cyan",
      "title": "Browser login path",
      "items": [
        "RealmsResource → OIDCLoginProtocolService.auth() → AuthorizationEndpoint creates an auth session and an AuthenticationProcessor",
        "Login forms post to LoginActionsService, which resumes the same processor",
        "On success finishAuthentication() → AuthenticationManager.redirectAfterSuccessfulFlow() → OIDCLoginProtocol.authenticated() redirects with a code",
        "The client then calls token(): TokenEndpoint dispatches the grant, which uses TokenManager"
      ]
    },
    {
      "dot": "violet",
      "title": "Implemented SPIs",
      "items": [
        "OIDCLoginProtocol implements LoginProtocol (server-spi-private)",
        "DefaultKeycloakSession(Factory) implement KeycloakSession(Factory) (server-spi); the Quarkus runtime subclasses both",
        "AuthorizationEndpoint extends AuthorizationEndpointBase, which owns createAuthenticationSession()"
      ]
    },
    {
      "dot": "emerald",
      "title": "Not drawn",
      "items": [
        "IdentityBrokerService (external IdP login), SAML protocol, account and admin sub-resources",
        "Built-in authenticators, required actions, client policies, OAuth2 grant types",
        "~1,600 main classes in total: this diagram covers the request entry points and the login flow"
      ]
    }
  ]
}
