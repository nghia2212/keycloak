  "cards": [
    {
      "dot": "cyan",
      "title": "Layering",
      "items": [
        "Factory → provider → adapter → entity: each provider wraps the request EntityManager",
        "Adapters implement the server-spi models (RealmAdapter: RealmModel, ClientAdapter: ClientModel, UserAdapter: UserModel) and keep the JPA entity",
        "RealmAdapter and ClientAdapter also implement JpaModel<entity> (only UserAdapter's edge is drawn)"
      ]
    },
    {
      "dot": "violet",
      "title": "Wiring",
      "items": [
        "JpaUserProviderFactory also gets its EntityManager from JpaConnectionProvider",
        "JpaRealmProvider implements RealmProvider, ClientProvider, ClientScopeProvider, GroupProvider and RoleProvider",
        "JpaConnectionProviderFactory is an interface here; the Quarkus runtime implements it and runs JpaUpdaterProvider at startup"
      ]
    },
    {
      "dot": "emerald",
      "title": "Not drawn",
      "items": [
        "~50 other entities (RoleEntity, GroupEntity, CredentialEntity, …) and Liquibase custom changes",
        "JPA event store, user-session persister, authorization (authorization.jpa.*) and workflow stores"
      ]
    }
  ]
