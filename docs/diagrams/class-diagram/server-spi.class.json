  "cards": [
    {
      "dot": "cyan",
      "title": "How the SPI fits together",
      "items": [
        "Each Spi names a Provider / ProviderFactory pair; factories are discovered via META-INF/services",
        "KeycloakSessionFactory holds one ProviderFactory per provider id and creates a KeycloakSession per request",
        "session.getProvider(X.class) asks the factory to create() a request-scoped Provider, closed with the session"
      ]
    },
    {
      "dot": "violet",
      "title": "Inheritance not drawn",
      "items": [
        "RealmProvider, UserProvider and UserSessionProvider extend Provider",
        "RealmModel extends RoleContainerModel; UserModel and GroupModel extend RoleMapperModel",
        "UserProvider also extends UserLookupProvider, UserQueryProvider, UserRegistrationProvider"
      ]
    },
    {
      "dot": "emerald",
      "title": "Implementations elsewhere",
      "items": [
        "Session / factory: DefaultKeycloakSession(Factory) in services",
        "Realm, user storage: model/jpa; user sessions: model/infinispan",
        "Also in this module: ClientProvider, RoleProvider, GroupProvider, KeyManager, TokenManager, AuthenticationSessionProvider"
      ]
    }
  ]
}
